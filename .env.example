# Copy to .env.local and fill in. .env.local is git-ignored.

# Anthropic API key used by POST /api/read to read letter photos.
# Server-side only; never exposed to the browser.
ANTHROPIC_API_KEY=

# Set to "fixture" to return the recorded sample result from
# tests/fixtures/reader/ with no network call (offline demo, E2E tests).
# Leave empty to call the real model.
LETTER_READER=
